rules_version = '2';
// SpinBet Casino — règles de sécurité Firestore.
// À coller dans la console Firebase : Firestore Database → Règles → Publier (voir FIREBASE.md).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function isName(n) { return n is string && n.size() >= 1 && n.size() <= 64; }
    function isNum(x, lo, hi) { return (x is int || x is float) && x >= lo && x <= hi; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function today() { return int(request.time.toMillis() / 86400000); }
    function isPseudo(n) { return n is string && n.size() >= 1 && n.size() <= 16; }
    function isGameId(g) { return g is string && g.size() <= 32; }
    // Look bought in the shop: { a: photo, f: cadre, b: badge, c: couleur }, short ids only.
    function isLook(l) { return l is map && l.keys().hasOnly(['a', 'f', 'b', 'c']) && l.size() <= 4; }

    // Profil complet du joueur : lu et écrit seulement par son propriétaire.
    // Le solde (bal, en centimes) est borné : impossible de s'écrire des milliards.
    match /users/{uid} {
      allow read, delete: if isMe(uid);
      allow create, update: if isMe(uid)
        && (!('bal' in request.resource.data) || isNum(request.resource.data.bal, 0, 10000000000))
        && (!('name' in request.resource.data) || isName(request.resource.data.name));
    }

    // Classement public : tout le monde lit, chacun n'écrit que sa ligne, avec des valeurs plausibles.
    match /leaderboard/{uid} {
      allow read: if true;
      allow delete: if isMe(uid);
      allow create, update: if isMe(uid)
        && request.resource.data.keys().hasOnly(['name', 'level', 'levelScore', 'bal', 'best', 'bestBonus', 'ach', 'updated', 'bestGame', 'bestBonusGame', 'look'])
        && (!('ach' in request.resource.data) || isNum(request.resource.data.ach, 0, 100000))
        && (!('bestGame' in request.resource.data) || isGameId(request.resource.data.bestGame))
        && (!('bestBonusGame' in request.resource.data) || isGameId(request.resource.data.bestBonusGame))
        && (!('look' in request.resource.data) || isLook(request.resource.data.look))
        && isName(request.resource.data.name)
        && isNum(request.resource.data.level, 1, 50)
        && isNum(request.resource.data.levelScore, 1, 51)
        && isNum(request.resource.data.bal, 0, 100000000)
        && isNum(request.resource.data.best, 0, 100000000)
        && isNum(request.resource.data.bestBonus, 0, 100000000);
    }

    // Parrainage : referrals/{nouveauCompte} = { by: parrain }. Créé une seule fois par le nouveau compte,
    // jamais modifié, jamais soi-même comme parrain. Lisible par le filleul et par son parrain.
    match /referrals/{uid} {
      allow create: if isMe(uid)
        && request.resource.data.keys().hasOnly(['by', 'name', 'at'])
        && request.resource.data.by is string
        && request.resource.data.by.size() > 5 && request.resource.data.by.size() < 128
        && request.resource.data.by != uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 16;
      allow read: if isMe(uid) || (signedIn() && resource.data.by == request.auth.uid);
      allow update, delete: if false;
    }

    // Défi de la semaine : challenges/{semaine}/scores/{uid}. Score lisible par tous, chacun écrit le sien,
    // et un record ne peut que monter.
    match /challenges/{week}/scores/{uid} {
      allow read: if true;
      allow create, update: if isMe(uid)
        && request.resource.data.keys().hasOnly(['name', 'best', 'game', 'updated'])
        && isName(request.resource.data.name)
        && isNum(request.resource.data.best, 0, 100000)
        && request.resource.data.game is string && request.resource.data.game.size() < 32
        && (resource == null || request.resource.data.best >= resource.data.best);
      allow delete: if false;
    }

    // Codes cadeaux : codes/{sha256 du code} = { uid, code, at }. Créé une seule fois, par le compte qui
    // utilise le code ; le document doit contenir le vrai code (son SHA-256 = l'id), donc impossible de
    // « griller » un code sans le connaître. Une 2e utilisation serait une modification : refusée.
    match /codes/{hash} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'code', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.code is string && request.resource.data.code.size() <= 32
        && hashing.sha256(request.resource.data.code).toHexString().lower() == hash;
      allow read, update, delete: if false;
    }

    // ---------- Chat général ----------
    // chat/{id} = { uid, name, text, at } : tout le monde lit ; seul un compte connecté écrit, à son nom,
    // 200 caractères max, un message toutes les 3 s (chatmeta/{uid}.last, écrit dans la même opération),
    // et pas s'il a été rendu muet. L'auteur ou un admin peut supprimer un message.
    match /chat/{id} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'at', 'look'])
        && (!('look' in request.resource.data) || isLook(request.resource.data.look))
        && request.resource.data.uid == request.auth.uid
        && isPseudo(request.resource.data.name)
        && request.resource.data.text is string && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 200
        && request.resource.data.at == request.time
        && !exists(/databases/$(database)/documents/mutes/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/chatmeta/$(request.auth.uid)).data.last == request.time
        && (!exists(/databases/$(database)/documents/chatmeta/$(request.auth.uid))
            || get(/databases/$(database)/documents/chatmeta/$(request.auth.uid)).data.last < request.time - duration.value(3, 's'));
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if false;
    }
    // Heure du dernier message de chaque joueur (anti-spam) : seulement « maintenant », par lui-même.
    match /chatmeta/{uid} {
      allow read: if isMe(uid);
      allow create, update: if isMe(uid) && request.resource.data.keys().hasOnly(['last']) && request.resource.data.last == request.time;
      allow delete: if false;
    }
    // Joueurs rendus muets (par un admin) et admins (ajoutés à la main dans la console Firebase).
    match /mutes/{uid} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /admins/{uid} {
      allow read: if isMe(uid);
      allow write: if false;
    }

    // ---------- Envoi de KE entre joueurs ----------
    // gifts/{id} = { from, fromName, to, toName, amount (centimes), at, claimed }.
    // Création par l'expéditeur seulement si, dans la même opération : son solde (users/{uid}.bal) baisse au moins
    // du montant, et son compteur du jour (sends/{uid}) augmente exactement du montant. 1 à 5 000 KE par envoi,
    // sans plafond par jour (autant d'envois qu'on veut), vers un compte qui existe, jamais soi-même. Lu par l'expéditeur et le destinataire ;
    // le destinataire le marque « récupéré » une seule fois (claimed false → true). Jamais supprimé.
    match /gifts/{id} {
      allow read: if signedIn() && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['from', 'fromName', 'to', 'toName', 'amount', 'at', 'claimed'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string && request.resource.data.to.size() > 5 && request.resource.data.to.size() < 128
        && request.resource.data.to != request.auth.uid
        && exists(/databases/$(database)/documents/users/$(request.resource.data.to))
        && isPseudo(request.resource.data.fromName) && isPseudo(request.resource.data.toName)
        && request.resource.data.amount is int && request.resource.data.amount >= 100 && request.resource.data.amount <= 500000
        && request.resource.data.claimed == false
        && request.resource.data.at == request.time
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.bal
            <= get(/databases/$(database)/documents/users/$(request.auth.uid)).data.bal - request.resource.data.amount
        && getAfter(/databases/$(database)/documents/sends/$(request.auth.uid)).data.day == today()
        && getAfter(/databases/$(database)/documents/sends/$(request.auth.uid)).data.total
            == (exists(/databases/$(database)/documents/sends/$(request.auth.uid))
                && get(/databases/$(database)/documents/sends/$(request.auth.uid)).data.day == today()
                ? get(/databases/$(database)/documents/sends/$(request.auth.uid)).data.total : 0) + request.resource.data.amount;
      allow update: if signedIn()
        && resource.data.to == request.auth.uid && resource.data.claimed == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimed'])
        && request.resource.data.claimed == true;
      allow delete: if false;
    }
    // Compteur des KE envoyés aujourd'hui : day = jour en cours, total en centimes (sans plafond), ne peut
    // que monter dans la journée.
    match /sends/{uid} {
      allow read: if isMe(uid);
      allow create, update: if isMe(uid)
        && request.resource.data.keys().hasOnly(['day', 'total'])
        && request.resource.data.day == today()
        && request.resource.data.total is int && request.resource.data.total >= 0
        && (resource == null || resource.data.day != today() || request.resource.data.total >= resource.data.total);
      allow delete: if false;
    }

    // ---------- Joueurs en ligne (en direct) ----------
    // presence/{uid} = { name, game, level, look, win, at } : tout le monde lit (qui est en ligne et à quoi il
    // joue) ; chacun n'écrit que sa ligne, avec l'heure du serveur. Supprimée à la fermeture du site.
    match /presence/{uid} {
      allow read: if true;
      allow create, update: if isMe(uid)
        && request.resource.data.keys().hasOnly(['name', 'game', 'level', 'look', 'win', 'at'])
        && isPseudo(request.resource.data.name)
        && isGameId(request.resource.data.game)
        && isNum(request.resource.data.level, 1, 50)
        && request.resource.data.at == request.time
        && (!('look' in request.resource.data) || isLook(request.resource.data.look))
        && (!('win' in request.resource.data) || (request.resource.data.win is map
            && request.resource.data.win.keys().hasOnly(['a', 'x', 't'])
            && isNum(request.resource.data.win.a, 0, 100000000)
            && isNum(request.resource.data.win.x, 0, 1000000)));
      allow delete: if isMe(uid);
    }

    // ---------- Amis ----------
    // friendreqs/{from}_{to} = { from, fromName, to, toName, status, at } : demande d'ami ('pending'), ou avis de
    // retrait ('removed'), écrite par l'expéditeur ; le destinataire peut seulement l'accepter (pending → accepted).
    // Lue et supprimée par l'un ou l'autre des deux joueurs.
    function isFriendReq(id) {
      return request.resource.data.keys().hasOnly(['from', 'fromName', 'to', 'toName', 'status', 'at'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string && request.resource.data.to.size() > 5 && request.resource.data.to.size() < 128
        && request.resource.data.to != request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.to
        && request.resource.data.status in ['pending', 'removed']
        && isPseudo(request.resource.data.fromName) && isPseudo(request.resource.data.toName)
        && request.resource.data.at == request.time;
    }
    match /friendreqs/{id} {
      allow read, delete: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if signedIn() && isFriendReq(id);
      allow update: if signedIn() && (
        (resource.data.from == request.auth.uid && isFriendReq(id))
        || (resource.data.to == request.auth.uid && resource.data.status == 'pending'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && request.resource.data.status == 'accepted'));
    }
    // friends/{uid} = { list: { uid: pseudo } } : la liste d'amis, lue et écrite seulement par son propriétaire.
    match /friends/{uid} {
      allow read, delete: if isMe(uid);
      allow create, update: if isMe(uid) && request.resource.data.keys().hasOnly(['list'])
        && request.resource.data.list is map && request.resource.data.list.size() <= 500;
    }

    // ---------- Tables en ligne (L'Éclair Online, Le 21 Online, Le Texas Online, les roues Online) ----------
    // Salons (L'Éclair Online, Le 21 Online, La Roue Folle, Le Plateau, La Pêche et La Roue d'Or Online) : seats/{uid} = le siège de chaque joueur (prêt, mise, décisions),
    // écrit par lui seul ; seeds/{n}-{k} = le tirage de la manche n, écrit une seule fois par le premier joueur
    // présent quand tout le salon est prêt (puis, au 21, quand tout le monde a fini).
    // Le Texas Online : une manche dure LEN ms sur l'horloge du serveur (manche r = temps / LEN) ; seeds/{r}-{k}
    // écrit après la fermeture des mises (ou des décisions), bets/{r}-{uid} écrit avant la limite.
    // chat : le chat de chaque table, mêmes règles que le chat général.
    function roomGame(g) { return g in ['storm-online', 'bj-online', 'madwheel-online', 'plateau-online', 'peche-online', 'roueor-online']; }
    function tableLen(g) { return {'holdem-online': 30000}.get(g, 0); }
    function seedAt(g, k) { return {'holdem-online': {'a': 9000, 'b': 21000}}.get(g, {}).get(k, 999999); }
    function betUntil(g) { return {'holdem-online': 21000}.get(g, 0); }
    match /tables/{game}/seats/{uid} {
      allow read: if true;
      allow create, update: if isMe(uid) && roomGame(game)
        && request.resource.data.keys().hasOnly(['name', 'look', 'n', 'ready', 'd', 'rt', 'acts', 'done', 'at'])
        && isPseudo(request.resource.data.name)
        && request.resource.data.at == request.time
        && (!('d' in request.resource.data) || (request.resource.data.d is map && request.resource.data.d.size() <= 160))
        && (!('acts' in request.resource.data) || (request.resource.data.acts is string && request.resource.data.acts.size() <= 12))
        && (!('look' in request.resource.data) || isLook(request.resource.data.look));
      allow delete: if isMe(uid);
    }
    match /tables/{game}/seeds/{id} {
      allow read: if true;
      allow create: if signedIn() && roomGame(game)
        && request.resource.data.keys().hasOnly(['n', 'k', 'rnd', 'at', 'p', 'acts'])
        && request.resource.data.n is int && request.resource.data.n > 0 && request.resource.data.k in ['a', 'b']
        && id == string(request.resource.data.n) + '-' + request.resource.data.k
        && request.resource.data.at == request.time
        && request.resource.data.rnd is string && request.resource.data.rnd.size() <= 40
        && (!('p' in request.resource.data) || (request.resource.data.p is list && request.resource.data.p.size() <= 20))
        && (!('acts' in request.resource.data) || request.resource.data.acts is map)
        && (request.resource.data.k == 'a' || exists(/databases/$(database)/documents/tables/$(game)/seeds/$(string(request.resource.data.n) + '-a')));
      allow create: if signedIn() && tableLen(game) > 0
        && request.resource.data.keys().hasOnly(['r', 'k', 'rnd', 'at', 'p'])
        && request.resource.data.r is int && request.resource.data.k in ['a', 'b']
        && id == string(request.resource.data.r) + '-' + request.resource.data.k
        && request.resource.data.at == request.time
        && request.time.toMillis() >= request.resource.data.r * tableLen(game) + seedAt(game, request.resource.data.k)
        && request.time.toMillis() < (request.resource.data.r + 1) * tableLen(game)
        && request.resource.data.rnd is string && request.resource.data.rnd.size() <= 40
        && (!('p' in request.resource.data) || (request.resource.data.p is list && request.resource.data.p.size() <= 20));
      allow update, delete: if false;
    }
    match /tables/{game}/bets/{id} {
      allow read: if true;
      allow create, update: if signedIn() && tableLen(game) > 0
        && request.resource.data.keys().hasOnly(['r', 'uid', 'name', 'look', 'd', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.r is int
        && id == string(request.resource.data.r) + '-' + request.auth.uid
        && isPseudo(request.resource.data.name)
        && request.resource.data.at == request.time
        && request.resource.data.d is map && request.resource.data.d.size() <= 10
        && request.time.toMillis() >= request.resource.data.r * tableLen(game)
        && request.time.toMillis() < request.resource.data.r * tableLen(game) + betUntil(game)
        && (!('look' in request.resource.data) || isLook(request.resource.data.look));
      allow delete: if false;
    }
    match /tables/{game}/chat/{id} {
      allow read: if true;
      allow create: if signedIn() && (tableLen(game) > 0 || roomGame(game))
        && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'at', 'look'])
        && (!('look' in request.resource.data) || isLook(request.resource.data.look))
        && request.resource.data.uid == request.auth.uid
        && isPseudo(request.resource.data.name)
        && request.resource.data.text is string && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 200
        && request.resource.data.at == request.time
        && !exists(/databases/$(database)/documents/mutes/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/chatmeta/$(request.auth.uid)).data.last == request.time
        && (!exists(/databases/$(database)/documents/chatmeta/$(request.auth.uid))
            || get(/databases/$(database)/documents/chatmeta/$(request.auth.uid)).data.last < request.time - duration.value(3, 's'));
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if false;
    }
    // Horloge : chaque joueur écrit l'heure du serveur dans clock/{uid} pour caler son compte à rebours.
    match /clock/{uid} {
      allow read: if isMe(uid);
      allow create, update: if isMe(uid) && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at == request.time;
    }

    // ---------- Défi spécial : special/{uid} = { prize, n, ke, at } ----------
    // Le million n'est versé qu'une fois par compte : le document est créé une seule fois, puis seul le compteur des
    // nouvelles machines peut monter (100 000 KE par machine, ke suit n).
    match /special/{uid} {
      allow read: if isMe(uid) || isAdmin();
      allow create: if isMe(uid) && request.resource.data.keys().hasOnly(['prize', 'n', 'ke', 'at'])
        && request.resource.data.prize is int && request.resource.data.prize >= 1000000 && request.resource.data.prize <= 10000000
        && request.resource.data.n is int && request.resource.data.n > 0 && request.resource.data.n < 500
        && request.resource.data.ke == request.resource.data.prize && request.resource.data.at == request.time;
      allow update: if isMe(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['n', 'ke'])
        && request.resource.data.n > resource.data.n && request.resource.data.n < 500
        && request.resource.data.ke == resource.data.ke + (request.resource.data.n - resource.data.n) * 100000;
      allow delete: if isAdmin();
    }

    // ---------- Suivi du site (lu seulement par les admins, page #admin) ----------
    // reports/{id} : un joueur signale un autre joueur (pseudo, message éventuel).
    match /reports/{id} {
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['by', 'byName', 'uid', 'name', 'text', 'at'])
        && request.resource.data.by == request.auth.uid && request.resource.data.uid is string && request.resource.data.uid.size() < 128
        && isPseudo(request.resource.data.byName) && request.resource.data.name is string && request.resource.data.name.size() <= 32
        && request.resource.data.text is string && request.resource.data.text.size() <= 300 && request.resource.data.at == request.time;
      allow read, delete: if isAdmin();
    }
    // errors/{id} : les erreurs JavaScript des joueurs (5 au plus par visite), pour les corriger vite.
    match /errors/{id} {
      allow create: if request.resource.data.keys().hasOnly(['msg', 'src', 'stack', 'url', 'game', 'ua', 'uid', 'at'])
        && request.resource.data.msg is string && request.resource.data.msg.size() <= 300
        && request.resource.data.src is string && request.resource.data.src.size() <= 300
        && request.resource.data.stack is string && request.resource.data.stack.size() <= 2000
        && request.resource.data.url is string && request.resource.data.url.size() <= 300
        && request.resource.data.game is string && request.resource.data.game.size() <= 40
        && request.resource.data.ua is string && request.resource.data.ua.size() <= 200
        && request.resource.data.uid is string && request.resource.data.uid.size() <= 128
        && request.resource.data.at == request.time;
      allow read, delete: if isAdmin();
    }
    // stats/{AAAA-MM-JJ} = { opens: { jeu: n }, spins: { jeu: n } } : combien de fois chaque jeu est ouvert et joué.
    match /stats/{day} {
      allow create, update: if request.resource.data.keys().hasOnly(['opens', 'spins'])
        && request.resource.data.opens is map && request.resource.data.spins is map
        && request.resource.data.opens.size() <= 120 && request.resource.data.spins.size() <= 120;
      allow read: if isAdmin();
    }

    // ---------- Tournois du soir et du week-end (events.js) ----------
    // tournois/{tid}/scores/{uid} = { name, best, spins, game, updated, look }, tid = soir_<début ms>_<fin ms> ou
    // we_<début>_<fin> : un score ne s'écrit que pendant le tournoi (5 min de marge à la fin), un tournoi dure 2 jours
    // au plus, le record (best, en × la mise, max win ×10 000 compris) et le nombre de tours ne peuvent que monter.
    function tourStart(tid) { return int(tid.split('_')[1]); }
    function tourEnd(tid) { return int(tid.split('_')[2]); }
    match /tournois/{tid}/scores/{uid} {
      allow read: if true;
      allow create, update: if isMe(uid)
        && tid.matches('^(soir|we)_[0-9]{13}_[0-9]{13}$')
        && tourEnd(tid) > tourStart(tid) && tourEnd(tid) - tourStart(tid) <= 180000000
        && request.time.toMillis() >= tourStart(tid) && request.time.toMillis() <= tourEnd(tid) + 300000
        && request.resource.data.keys().hasOnly(['name', 'best', 'spins', 'game', 'updated', 'look'])
        && isName(request.resource.data.name)
        && isNum(request.resource.data.best, 0, 10000)
        && request.resource.data.spins is int && request.resource.data.spins >= 0 && request.resource.data.spins <= 200000
        && isGameId(request.resource.data.game)
        && (!('look' in request.resource.data) || isLook(request.resource.data.look))
        && (resource == null || (request.resource.data.best >= resource.data.best && request.resource.data.spins >= resource.data.spins));
      allow delete: if false;
    }

    // ---------- Jackpot commun (jackpot.js) ----------
    // jackpot/main = { amount, last } : amount = ce que la cagnotte a gagné depuis le dernier jackpot (KE). Chaque compte
    // y ajoute 1 % de ses mises (100 000 KE au plus par envoi) ; celui qui touche le max win d'une machine la vide
    // (last = son nom, à l'heure du serveur) et laisse une trace dans jackpotwins/{id}.
    match /jackpot/{id} {
      allow read: if true;
      allow create: if signedIn() && id == 'main' && request.resource.data.keys().hasOnly(['amount'])
        && isNum(request.resource.data.amount, 0, 100000);
      allow update: if signedIn() && id == 'main' && request.resource.data.keys().hasOnly(['amount', 'last'])
        && isNum(request.resource.data.amount, -100000, 1000000000)
        && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['amount'])
            && request.resource.data.amount > resource.data.amount
            && request.resource.data.amount <= resource.data.amount + 100000)
          || (request.resource.data.last is map
            && request.resource.data.last.keys().hasOnly(['uid', 'name', 'game', 'ke', 'at'])
            && request.resource.data.last.uid == request.auth.uid
            && request.resource.data.last.at == request.time
            && isPseudo(request.resource.data.last.name) && isGameId(request.resource.data.last.game)
            && isNum(request.resource.data.last.ke, 0, resource.data.amount + 100000)
            && request.resource.data.amount <= resource.data.amount)
        );
      allow delete: if false;
    }
    match /jackpotwins/{id} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['uid', 'name', 'game', 'ke', 'share', 'at'])
        && request.resource.data.uid == request.auth.uid
        && isPseudo(request.resource.data.name) && isGameId(request.resource.data.game)
        && isNum(request.resource.data.ke, 0, 1000000000) && isNum(request.resource.data.share, 0, 1)
        && request.resource.data.at == request.time;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ---------- Duels entre amis (duels.js) ----------
    // duels/{id} = { from, fromName, to, toName, game, spins, stake, status, at, acc, fn, fp, tn, tp }.
    // Créé par le joueur qui défie (en attente) ; l'invité accepte ou refuse dans les 24 h ; celui qui défie peut
    // annuler tant que personne n'a répondu ; ensuite chacun n'écrit que ses tours (fn/fp ou tn/tp), qui ne font que
    // monter, pendant 24 h après l'acceptation. Lu par les deux joueurs seulement.
    function duelProgress(n, p) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([n, p])
        && request.resource.data[n] is int && request.resource.data[n] >= resource.data[n] && request.resource.data[n] <= resource.data.spins
        && isNum(request.resource.data[p], 0, 1000000) && request.resource.data[p] >= resource.data[p];
    }
    match /duels/{id} {
      allow read: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['from', 'fromName', 'to', 'toName', 'game', 'spins', 'stake', 'status', 'at', 'fn', 'fp', 'tn', 'tp'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string && request.resource.data.to.size() > 5 && request.resource.data.to.size() < 128
        && request.resource.data.to != request.auth.uid
        && isPseudo(request.resource.data.fromName) && isPseudo(request.resource.data.toName)
        && isGameId(request.resource.data.game)
        && request.resource.data.spins in [20, 50, 100]
        && request.resource.data.stake is int && request.resource.data.stake >= 0 && request.resource.data.stake <= 100000
        && request.resource.data.status == 'pending'
        && request.resource.data.fn == 0 && request.resource.data.fp == 0 && request.resource.data.tn == 0 && request.resource.data.tp == 0
        && request.resource.data.at == request.time;
      allow update: if signedIn() && (
        (resource.data.to == request.auth.uid && resource.data.status == 'pending'
          && request.time < resource.data.at + duration.value(24, 'h')
          && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acc'])
                && request.resource.data.status == 'accepted' && request.resource.data.acc == request.time)
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) && request.resource.data.status == 'declined')))
        || (resource.data.from == request.auth.uid && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) && request.resource.data.status == 'cancelled')
        || (resource.data.status == 'accepted' && request.time < resource.data.acc + duration.value(1445, 'm')
          && ((resource.data.from == request.auth.uid && duelProgress('fn', 'fp'))
            || (resource.data.to == request.auth.uid && duelProgress('tn', 'tp'))))
      );
      allow delete: if false;
    }

    // Tout le reste est fermé.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
